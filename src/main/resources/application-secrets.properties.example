spring.datasource.password=your_local_postgres_password

app.jwt.secret=generate_a_random_base64_encoded_256bit_secret

# Opsiyonel - lokalde e-posta gerçekten göndermek istersen (aksi halde
# ResendEmailService anahtar yokken sessizce loglayıp atlar, uygulama yine
# çalışır). resend.com'da ücretsiz hesap açıp "API keys" bölümünden alınır.
resend.api-key=re_xxxxxxxxxxxxxxxxxxxxxxxx
